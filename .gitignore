# ============================================
# Claude Code .gitignore
# Track: commands, settings, plugin config
# Ignore: history, sessions, caches, projects
# ============================================

# --- Conversation & session history ---
history.jsonl
sessions/
session-env/
file-history/
shell-snapshots/

# --- Project-specific context & memory ---
# Contains per-project memory, CLAUDE.md overrides,
# and machine-specific paths encoded in directory names
projects/

# --- Session-scoped work tracking ---
tasks/
todos/
plans/

# --- Caches & ephemeral state ---
cache/
image-cache/
paste-cache/
debug/
downloads/
backups/
stats-cache.json

# --- Telemetry & analytics ---
telemetry/

# --- IDE integration ---
ide/

# --- Auth & runtime state ---
mcp-needs-auth-cache.json
policy-limits.json
.credentials.json

# --- Lock files ---
*.lock

# --- Downloaded plugin marketplaces (fetched from remote) ---
plugins/marketplaces/
known_marketplaces.json

# --- Work-specific commands (not shareable) ---
commands/work-*

# --- OS artifacts ---
.DS_Store
