# ============================================
# Claude Code (~/.claude) .gitignore
#
# Track:  commands/, agents/, skills/ (authored),
#         workflow/, CLAUDE.md, README.md
# Ignore: settings, credentials, history, sessions,
#         caches, projects, synced/downloaded content
# ============================================

# --------------------------------------------
# Settings & credentials (machine-specific)
# --------------------------------------------
settings.json
settings.local.json
managed-settings.json
remote-settings.json
.credentials.json
.claude.json
.claude.json.backup
keybindings.json
statusline.sh
config.json
*.local.json

# Policy / entitlement state
policy-limits.json
*.stamp.json

# --------------------------------------------
# Conversation & session history
# --------------------------------------------
history.jsonl
sessions/
session-env/
file-history/
shell-snapshots/
transcripts/
logs/
*.log

# --------------------------------------------
# Project-specific context & memory
# Per-project memory, CLAUDE.md overrides, and
# machine-specific paths encoded in dir names
# --------------------------------------------
projects/
memory/

# --------------------------------------------
# Session-scoped work tracking
# --------------------------------------------
tasks/
todos/
plans/
worktrees/
scratchpad/

# --------------------------------------------
# Caches & ephemeral state
# --------------------------------------------
cache/
image-cache/
paste-cache/
debug/
downloads/
backups/
tmp/
stats-cache.json
statsig/
telemetry/
analytics/
.last-cleanup
.last-update-result.json
mcp-needs-auth-cache.json
mcp-logs*/

# --------------------------------------------
# IDE integration & runtime
# --------------------------------------------
ide/
versions/
local/

# --------------------------------------------
# Plugins — authored config tracked,
# downloaded/synced content ignored
# --------------------------------------------
plugins/marketplaces/
plugins/repos/
plugins/cache/
plugins/synced/
known_marketplaces.json

# --------------------------------------------
# Skills & agents — authored tracked,
# synced/bundled content ignored
# --------------------------------------------
skills/synced/
agents/synced/
.bucket-*

# --------------------------------------------
# Work-specific commands (not shareable)
# --------------------------------------------
commands/work-*

# --------------------------------------------
# Lock files & dependencies
# --------------------------------------------
*.lock
node_modules/
.npm/
__pycache__/
*.py[cod]
.venv/
venv/

# --------------------------------------------
# OS & editor artifacts
# --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
